# Database connection string (has to use the asyncpg driver)
#
# Local database (docker compose in the astep-aau/data repo):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/data
#
# Server database from your machine, after:
#   kubectl port-forward svc/dataset-postgres -n main 5433:5432
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5433/data

# Debug mode: logs every SQL statement (true/false)
DEBUG=false

# Check on startup that the database has applied the latest expected migration (true/false)
DB_CHECK_MIGRATIONS=true

# Postgres used by the integration tests in tests/db (skipped when unset).
# Tests run inside a transaction that is rolled back, so the local database is left unchanged.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/data
